# AWS Student Builder Group NMIET — environment variables
# Copy to .env.local for local development (never commit .env.local).
# In production set the same values in Amplify → Environment variables.
# See docs/setup.md for where each value comes from.

# ── Cognito (sign-in) ────────────────────────────────────────
NEXT_PUBLIC_COGNITO_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# App client secret — server-side only
COGNITO_CLIENT_SECRET=

# ── DynamoDB tables (created by `node scripts/setup-aws.mjs`) ─
DYNAMODB_EVENTS_TABLE=acc-nmiet-events
DYNAMODB_TEAM_TABLE=acc-nmiet-team
DYNAMODB_PROJECTS_TABLE=acc-nmiet-projects
DYNAMODB_ACHIEVEMENTS_TABLE=acc-nmiet-achievements
DYNAMODB_RESOURCES_TABLE=acc-nmiet-resources
DYNAMODB_SOCIAL_TABLE=acc-nmiet-social-links
DYNAMODB_CONFIG_TABLE=acc-nmiet-site-config
DYNAMODB_CONTACTS_TABLE=acc-nmiet-contact-submissions
DYNAMODB_PROFILES_TABLE=acc-nmiet-user-profiles

# ── S3 (admin uploads) ───────────────────────────────────────
NEXT_PUBLIC_S3_BUCKET=acc-nmiet-media
NEXT_PUBLIC_S3_REGION=ap-south-1

# ── SES (contact form) ───────────────────────────────────────
# The sender must be a verified SES identity. Messages go to SES_TO_EMAIL
# (defaults to the club email).
SES_REGION=ap-south-1
SES_FROM_EMAIL=
SES_TO_EMAIL=aws.studentbuildersgroup.nmiet@gmail.com

# ── AWS credentials ──────────────────────────────────────────
# Production: leave unset — the Amplify SSR compute role is used
# (docs/aws/amplify-compute-role.md).
# Local: the SDK reads your AWS CLI profile / SSO session (AWS_PROFILE).
# Only if you must use an access key:
# APP_ACCESS_KEY_ID=
# APP_SECRET_ACCESS_KEY=
APP_REGION=ap-south-1
